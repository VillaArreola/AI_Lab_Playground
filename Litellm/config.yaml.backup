# =========================================================
# ROUTER SETTINGS (Estrategias de enrutamiento y failover)
# =========================================================
router_settings:
  routing_strategy: "simple-shuffle"  # Opciones: simple-shuffle, latency-based-routing, usage-based-routing
  num_retries: 3                      # Reintentos por modelo antes de pasar al siguiente
  timeout: 300                        # Timeout global en segundos
  cooldown_time: 60                   # Esperar 60s antes de reintentar modelo fallido
  retry_delay: 2                      # 2 segundos entre reintentos

# =========================================================
# LITELLM SETTINGS (Configuraciones avanzadas)
# =========================================================
litellm_settings:
  # Logging
  set_verbose: false                  # true en desarrollo para debug
  json_logs: false                    # true en producción para logs estructurados
  
  # Performance
  stream: true                        # Streaming habilitado por defecto
  drop_params: true                   # Elimina params no soportados por modelo
  
  # Success/Failure tracking
  success_callback: []                # Ej: ["langfuse", "prometheus"] si quieres monitoreo
  failure_callback: []                # Ej: ["sentry"] para alertas de errores

# =========================================================
# GENERAL SETTINGS (Configuraciones globales)
# =========================================================
general_settings:
  # Seguridad
  master_key: os.environ/LITELLM_MASTER_KEY
  allowed_fails: 3
  
  # Presupuesto Global (Seguridad para APIs de pago futuras)
  max_budget: 100.0                   # Límite de $100 USD
  budget_duration: 30d                # Se reinicia cada 30 días

  # Database (ya configurado en docker-compose)
  database_url: os.environ/DATABASE_URL
  store_model_in_db: true
  
  # Caching (Ahorra dinero en consultas repetidas)
  cache:
    type: redis
    host: redis
    port: 6379
    password: os.environ/REDIS_PASSWORD
    ttl: 3600                         # 1 hora para chat/completions
    supported_call_types: ["completion", "acompletion", "embedding"]
    
  # Cache específico para embeddings (más largo porque no cambian)
  embedding_cache_ttl: 7200           # 2 horas para embeddings
